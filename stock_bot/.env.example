# Alpaca (https://alpaca.markets) — market-data source AND order execution.
# KEEP ALPACA_PAPER=true until you've watched the bot run correctly;
# "false" places real orders with real money.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# "iex" works on free/paper accounts; "sip" needs a paid market-data plan
# (historical bars 403s on "sip" without one).
ALPACA_DATA_FEED=iex

# X (Twitter) API v2 app-only bearer token (developer.x.com). No free tier
# as of 2026 — this is a billed, pay-per-use developer account.
X_BEARER_TOKEN=
X_LOOKBACK_HOURS=24
X_MAX_RESULTS_PER_QUERY=100

# Anthropic (https://console.anthropic.com) — CEO/prospects/valuation research
ANTHROPIC_API_KEY=
# claude-haiku-4-5 = cost-optimized (~half the cost of Sonnet 5, less
# nuanced on ambiguous calls). Set to claude-sonnet-5 for better judgment
# at higher cost.
ANTHROPIC_MODEL=claude-haiku-4-5

# Financial Modeling Prep (https://financialmodelingprep.com) — fundamentals + ROE
FMP_API_KEY=

# Trading
DOLLARS_PER_STOCK=2.00
NUM_STOCKS=10

# Candidate pool
CANDIDATE_POOL_SIZE=50
SHORTLIST_SIZE=12
# Today's top % gainers (Alpaca movers screener), merged into the pool so
# a stock having a strong move without (yet) being top-VOLUME can still be
# found — the most-actives screener alone can never surface it. Set to 0
# to disable.
MOVERS_POOL_SIZE=25

# How many recent news articles (from FMP) to fetch per shortlisted symbol
# and hand to the AI research step as grounding context.
NEWS_ARTICLES_PER_SYMBOL=4

# Strategy filters
MAX_STOCK_PRICE=30.00
# Floor added after live testing showed the movers screener's "top
# gainers" were mostly sub-$1 penny stocks/warrants with huge but
# illiquid-noise percentage swings (e.g. +2967% on a $0.007 warrant).
MIN_STOCK_PRICE=2.00
MOMENTUM_LOOKBACK_DAYS=20

# Risk management — this bot previously only ever bought, never sold.
# STOP_LOSS_PCT is always active; TAKE_PROFIT_PCT=0 means disabled
# ("let winners ride"), set e.g. 0.40 to take profit at +40%.
STOP_LOSS_PCT=-0.20
TAKE_PROFIT_PCT=0

# Scoring weights (need not sum to 1 — they're a weighted blend, not an
# average — but keeping them roughly normalized makes final_score easier
# to read). Lower WEIGHT_VOLUME favors *less*-active names within the
# day's active pool, not "highest volume" as the name might suggest.
WEIGHT_VOLUME=0.10
WEIGHT_X=0.15
WEIGHT_MOMENTUM=0.20
WEIGHT_ROE=0.20
WEIGHT_AI_RESEARCH=0.35
