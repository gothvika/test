# Alpaca (https://alpaca.markets) — paper trading keys by default
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# "iex" works on free/paper accounts; "sip" needs a paid market-data plan
# (historical bars 403s on "sip" without one).
ALPACA_DATA_FEED=iex

# X (Twitter) API v2 app-only bearer token (developer.x.com). No free tier
# as of 2026 — this is a billed, pay-per-use developer account.
X_BEARER_TOKEN=
X_LOOKBACK_HOURS=24
X_MAX_RESULTS_PER_QUERY=100

# Anthropic (https://console.anthropic.com) — CEO/prospects/valuation research
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Financial Modeling Prep (https://financialmodelingprep.com) — fundamentals + ROE
FMP_API_KEY=

# Trading
DOLLARS_PER_STOCK=1.00
NUM_STOCKS=10

# Candidate pool
CANDIDATE_POOL_SIZE=50
SHORTLIST_SIZE=20

# Strategy filters
MAX_STOCK_PRICE=30.00
MOMENTUM_LOOKBACK_DAYS=20

# Scoring weights (need not sum to 1 — they're a weighted blend, not an
# average — but keeping them roughly normalized makes final_score easier
# to read). Lower WEIGHT_VOLUME favors *less*-active names within the
# day's active pool, not "highest volume" as the name might suggest.
WEIGHT_VOLUME=0.10
WEIGHT_X=0.15
WEIGHT_MOMENTUM=0.20
WEIGHT_ROE=0.20
WEIGHT_AI_RESEARCH=0.35
