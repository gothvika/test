# Alpaca (https://alpaca.markets) — paper trading keys by default
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Financial Modeling Prep (https://financialmodelingprep.com) — for fundamentals.py
FMP_API_KEY=

# Reddit "script" app (https://www.reddit.com/prefs/apps) — optional
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=stock_bot/1.0
REDDIT_SUBREDDITS=wallstreetbets,stocks,investing
REDDIT_LOOKBACK_HOURS=24
REDDIT_POST_LIMIT=200

# Candidate pool / scoring
CANDIDATE_POOL_SIZE=50
SHORTLIST_SIZE=15
NUM_STOCKS=10
WEIGHT_VOLUME=0.3
WEIGHT_REDDIT=0.2
WEIGHT_AI_RESEARCH=0.5

# Trading
DOLLARS_PER_STOCK=1.0

# State / logging
STATE_FILE=last_run.json
LOG_FILE=stock_bot.log
